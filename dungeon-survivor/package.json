{
  "name": "dungeon-survivor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "spec:build": "node scripts/build-spec-html.mjs",
    "spec:test": "node --test scripts/build-spec-html.test.mjs",
    "test": "npm run spec:test && vitest run",
    "build": "npm run typecheck && vite build && node scripts/build-spec-html.mjs --out dist/specs.html && npm run spec:build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
